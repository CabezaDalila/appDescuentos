# =====================================================================
# Variables de entorno — App de Descuentos
#
# La forma MÁS FÁCIL de tener esto en local NO es copiar este archivo, sino
# bajar las variables desde Vercel (ver docs/SETUP.md):
#
#   vercel link            # linkear al proyecto "app-descuentos"
#   vercel env pull .env.local --environment=production
#
# Eso trae TODO menos el service account de Firebase (marcado [MANUAL] abajo),
# que hay que agregar a mano porque Vercel no exporta las claves "sensitive".
#
# Este archivo es solo referencia de qué variables existen y de dónde salen.
# NUNCA subas .env.local (tiene secretos reales); sí se puede subir .env.example.
# =====================================================================

# ─── Firebase (cliente) — [VERCEL] ─────────────────────────────────────
# Claves públicas por diseño (van al browser). Proyecto: app-descuentos-9b546.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENTID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── Firebase Admin (servidor) — [MANUAL] ──────────────────────────────
# NO está en Vercel (son "sensitive"). Generalas en Firebase Console →
# Configuración → Cuentas de servicio → "Generar nueva clave privada" (baja un
# JSON). Necesarias para:
#   - el puente Supabase→Firebase (mintea el custom token)   [src/lib/firebase/admin-server.ts]
#   - los guards de las API routes (verifica ID tokens)      [src/lib/server/auth.ts]
# La private key va entre comillas y con los \n escapados (tal cual el JSON).
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# ─── Supabase — [VERCEL] (sincronizadas por la integración Vercel↔Supabase) ─
# URL y publishable/anon son públicas (browser, respetan RLS).
# La secret/service_role es SECRETA (solo servidor). Proyecto: jhkkvldybkohejhpsbuc.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Postgres de Supabase — [VERCEL] ───────────────────────────────────
# Conexión a la base (para la futura migración de datos a Postgres). Aún no se usa.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# ─── Integraciones — [VERCEL] ──────────────────────────────────────────
GEMINI_API_KEY=                 # Recomendaciones IA (servidor)
NEXT_PUBLIC_ONESIGNAL_APP_ID=   # Push
ONESIGNAL_REST_API_KEY=         # Push (servidor)
NEXT_PUBLIC_OPEN_ROUTE_DISTANCE=
